### resolved (via ff-lib.sh - environment, not script text)
output_dir: $HOME/FaceFusion/output
app_dir:    $HOME/pinokio/api/Facefusion-Pinokio-Masterbranch.git/facefusion
conda_path: $HOME/pinokio/api/Facefusion-Pinokio-Masterbranch.git/.env

### ff-ai.sh
cwd:   $FF_DIR/facefusion
conda: $CONDA_ENV_PATH
lib:   ff-lib.sh
cmd1:  python ../no_reject.py batch-run -s "$FACE_DIR/$2" -t "$3/*.$4" -o "$OUTPUT_DIR/$1{index}.$4" --processors face_swapper --face-selector-mode one

### ff-batch.sh
cwd:   $FF_DIR/facefusion
conda: $CONDA_ENV_PATH
lib:   ff-lib.sh
cmd1:  python ../no_reject.py batch-run -s "$FACE_DIR/$2" -t "$3/*.$4" -o "$OUTPUT_DIR/$1{index}.$4" --processors face_swapper face_enhancer --face-detector-angles 0 90 270

### ff-cartoon.sh
cwd:   $FF_DIR/facefusion
conda: $CONDA_ENV_PATH
lib:   ff-lib.sh
cmd1:  python ../no_reject.py batch-run -t "$2/*.$3" -o "$OUTPUT_DIR/$1{index}.$3" --processors frame_colorizer

### ff-color.sh
cwd:   $FF_DIR/facefusion
conda: $CONDA_ENV_PATH
lib:   ff-lib.sh
cmd1:  python ../no_reject.py batch-run -t "$2/*.$3" -o "$OUTPUT_DIR/$1{index}.$3" --processors frame_colorizer --frame-colorizer-model deoldify_stable

### ff-edit.sh
cwd:   $FF_DIR/facefusion
conda: $CONDA_ENV_PATH
lib:   ff-lib.sh
cmd1:  python ../no_reject.py batch-run -t "$2/*.$3" -o "$OUTPUT_DIR/$1{index}.$3" --processors face_editor face_enhancer --face-detector-angles 0 90 270 --face-editor-mouth-smile -0.5 --face-editor-lip-open-ratio -0.8

