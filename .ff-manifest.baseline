### ff-lipsync.sh
cwd:   $FF_DIR/facefusion
conda: $CONDA_ENV_PATH
lib:   ff-lib.sh
cmd1:  python ../no_reject.py headless-run -s "$AUDIO" -t "$VIDEO" -o "$OUT_FILE" --processors "$PROCESSORS[@]" --lip-syncer-weight "$WEIGHT" "$TRIM_ARGS[@]"

